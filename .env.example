SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<your-key>
SUPABASE_SECRET_KEY=sb_secret_<your-key>
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Optional Next.js public client settings. Use the project URL and publishable key.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_<your-key>

# Mode satu kode: biarkan tiga kode peran kosong. DEMO_PASSCODE menjadi satu-satunya kode akses.
# Mode peran: isi KODE_AKSES_AUDITOR, KODE_AKSES_PEJABAT, dan KODE_AKSES_SYARIAH sekaligus.
# DEMO_PASSCODE menjadi kode untuk peran penyedia data.
DEMO_PASSCODE=replace-with-a-long-random-value
KODE_AKSES_AUDITOR=
KODE_AKSES_PEJABAT=
KODE_AKSES_SYARIAH=
DEMO_MODE=false
